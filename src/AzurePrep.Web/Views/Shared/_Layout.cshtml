<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AzurePrep</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <span class="site-brand__mark">AzurePrep</span>
                <span class="site-brand__sub">Simulados de certificação Microsoft</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                var avatar = User.FindFirst("avatar")?.Value;
                <div class="site-user">
                    @if (!string.IsNullOrWhiteSpace(avatar))
                    {
                        <img class="site-user__avatar" src="@avatar" alt="" referrerpolicy="no-referrer" />
                    }
                    <span class="site-user__name">@User.Identity.Name</span>
                    <form asp-controller="Conta" asp-action="Sair" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn site-user__signout">Sair</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
