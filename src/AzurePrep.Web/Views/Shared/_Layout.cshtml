<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AzurePrep</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <span class="site-brand__mark">AzurePrep</span>
                <span class="site-brand__sub">Simulados de certificação Microsoft</span>
            </a>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
