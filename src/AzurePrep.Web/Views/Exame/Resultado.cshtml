@model ResultadoDaProvaDto
@inject OpcoesDeDoacao Doacao
@{
    ViewData["Title"] = $"Resultado · {Model.ExamCode}";
    var duration = Model.FinishedAt - Model.StartedAt;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // Posições na régua da escala 1–1000.
    var fillPercent = (Model.ScaledScore / 1000m * 100m).ToString("0.##", inv);
    var cutPercent = (Model.ScaledPassingScore / 1000m * 100m).ToString("0.##", inv);
}

@*
    Score report fiel ao relatório real: nota na escala 1–1000, veredito e desempenho
    relativo por domínio — sem percentual de acertos e sem revelar o gabarito. A revisão
    questão a questão vive em uma tela separada, que a prova real não oferece.
*@
<section class="result">
    <div class="score-report score-report--@(Model.Passed ? "pass" : "fail")">
        <p class="score-report__cut">@Model.ExamCode · @Model.ExamName</p>

        <div>
            <span class="score-report__value">@Model.ScaledScore</span>
            <span class="score-report__max">/ 1000</span>
        </div>

        <div>
            <span class="score-report__verdict">@(Model.Passed ? "Aprovado" : "Reprovado")</span>
        </div>

        <p class="score-report__cut">Nota mínima para aprovação: @Model.ScaledPassingScore</p>

        <div class="score-scale">
            <div class="score-scale__track">
                <div class="score-scale__fill" style="width:@fillPercent%"></div>
                <div class="score-scale__cut" style="left:@cutPercent%" title="Nota de corte: @Model.ScaledPassingScore"></div>
            </div>
            <div class="score-scale__ends">
                <span>1</span>
                <span>1000</span>
            </div>
        </div>

        <dl class="result__meta">
            <div>
                <dt>Data</dt>
                <dd>@Model.FinishedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
            </div>
            <div>
                <dt>Itens</dt>
                <dd>@Model.TotalQuestions</dd>
            </div>
            <div>
                <dt>Tempo utilizado</dt>
                <dd>@($"{(int)duration.TotalMinutes}m {duration.Seconds:00}s")</dd>
            </div>
        </dl>
    </div>

    @*
        Barras sem números, como no relatório real: o candidato vê onde ficou mais forte
        ou mais fraco, não a contagem exata de acertos por domínio.
    *@
    <section class="result__section">
        <h2 class="section-title">Desempenho por domínio</h2>
        <div class="skill-breakdown">
            @foreach (var area in Model.SkillAreas)
            {
                <div class="skill-row">
                    <div class="skill-row__head">
                        <span class="skill-row__name">@area.Name</span>
                    </div>
                    <div class="skill-row__bar">
                        <div class="skill-row__fill" style="width:@area.ScorePercent.ToString("0.##", inv)%"></div>
                    </div>
                </div>
            }
        </div>
    </section>

    <div class="result__actions">
        <a class="btn btn--primary" asp-controller="Exame" asp-action="Revisao" asp-route-attemptId="@Model.AttemptId">
            Revisar questões e gabarito
        </a>
        <a class="btn" asp-controller="Home" asp-action="Index">Voltar ao início</a>
    </div>

    @*
        Único ponto do fluxo de prova onde o assunto aparece, e ainda assim depois dos botões:
        aqui o valor já foi entregue. Durante a simulação não entra nada — a imersão é o produto.
    *@
    @if (Doacao.EstaConfigurado)
    {
        <p class="result__apoio">
            Este simulado é gratuito e sem anúncios.
            <a asp-controller="Apoiar" asp-action="Index">Apoiar o projeto</a>
        </p>
    }
</section>
