# Build
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# Banco SQLite local (recriado no startup via Migrate + Seed)
*.db
*.db-shm
*.db-wal
src/AzurePrep.Web/App_Data/*.db*
*.design.db*

# Chaves de Data Protection (criptografam o cookie de autenticação) — material
# sensível gerado por instância, nunca versionado
src/AzurePrep.Web/App_Data/dp-keys/

# Documentação interna de sessões (não versionada)
/docs/

# Credenciais do container (OAuth, SMTP) — o modelo versionado é o .env.exemplo
.env

# IDE / usuário
.vs/
.vscode/
.idea/
*.user
*.suo

# Config local do Claude Code (específica da máquina, não compartilhada)
.claude/

# .NET
project.lock.json
*.nupkg
TestResults/
[Cc]overage*/
